<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <div class="bg-dark text-white border-end" id="sidebar-wrapper" style="min-width: 250px; min-height: 100vh;">
            <div class="sidebar-heading text-center py-4 border-bottom border-secondary">
                <i class="fa-solid fa-server me-2"></i> Inventario IT
            </div>
            <div class="list-group list-group-flush">
                <a href="@Url.Action("Dashboard", "Inventario")" class="list-group-item list-group-item-action bg-dark text-white p-3 border-secondary">
                    <i class="fa-solid fa-chart-line me-2"></i> Dashboard
                </a>
                <a href="@Url.Action("Registrar", "Inventario")" class="list-group-item list-group-item-action bg-dark text-white p-3 border-secondary">
                    <i class="fa-solid fa-barcode me-2"></i> Registrar Activo
                </a>
                <a href="@Url.Action("Gestionar", "Inventario")" class="list-group-item list-group-item-action bg-dark text-white p-3 border-secondary">
                    <i class="fa-solid fa-pen-to-square me-2"></i> Gestionar Estados
                </a>
                <a href="@Url.Action("ReporteMensual", "Inventario")" class="list-group-item list-group-item-action bg-dark text-white p-3 border-secondary">
                    <i class="fa-solid fa-chart-area me-2"></i> Reporte Mensual
                </a>
            </div>
        </div>

        <div id="page-content-wrapper" class="w-100">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-4">
                <span class="navbar-brand">Sistema de Gestión v1.0</span>
            </nav>
            <div class="container-fluid px-4 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
